# GitHub PAT (classic or fine-grained). Needs at minimum public_repo read access.
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Shared secret your website backend (the MCP client) must send as
# `Authorization: Bearer <this value>` on every request to this server.
# Generate any long random string, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# Optional
HOST=0.0.0.0
PORT=8000

# Only needed for the Phase 3 test harness (server/test_subagent.py), not
# the MCP server itself.
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
